# Copia este archivo como .env.local y rellena la clave.
# Sin ANTHROPIC_API_KEY la app funciona en MODO DEMO con datos de ejemplo.

# Clave de la API de Claude: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Modelo de Claude (por defecto claude-opus-5)
# CLAUDE_MODEL=claude-opus-5

# Fuerza el modo demo aunque haya API key (1 = sí)
# FRIGO_DEMO=1

# Código de la beta: si lo pones, hay que escribirlo una vez para entrar.
# Es lo que evita que el enlace corra por ahí y te gasten el saldo.
# Vacío = app abierta (lo normal en local).
# FRIGO_BETA_CODE=

# Límite de peticiones por IP y hora
# RATE_DETECT_PER_HOUR=20
# RATE_RECIPES_PER_HOUR=30

# Límite compartido entre todas las instancias (necesario al publicar en Vercel).
# Se crea gratis en https://upstash.com → Redis → REST API. Sin esto, cada
# instancia lleva su propia cuenta y el límite se puede saltar.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
