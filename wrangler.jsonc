{
  // Publicar: npm run deploy
  // Las variables (ANTHROPIC_API_KEY, FRIGO_BETA_CODE) NO van aquí:
  // se ponen como secretos en el panel de Cloudflare.
  "name": "frigo",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
